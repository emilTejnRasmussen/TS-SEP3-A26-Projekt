FROM eclipse-temurin:21-jdk AS build

WORKDIR /workspace
COPY . .

WORKDIR /workspace/Backend/EventServer
RUN chmod +x mvnw && ./mvnw -DskipTests package

FROM eclipse-temurin:21-jre

WORKDIR /app
COPY --from=build /workspace/Backend/EventServer/target/*.jar app.jar

EXPOSE 9090

ENTRYPOINT ["java", "-jar", "app.jar"]
